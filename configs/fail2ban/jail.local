# Template rendered by bookstack.sh (Security -> fail2ban): the double-at placeholders are filled in.
# @@CADDY_LOG@@ = $STACK_DIR/caddy/data/access.log; bookstack.sh creates it if missing (fail2ban
# refuses to start with a missing logpath, which would also take the sshd jail down).
[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 5
backend = systemd

[sshd]
enabled = true

# Web logins arrive through Cloudflare, so a ban must be placed AT Cloudflare (an IP Access
# Rule on the zone) — banning in the local firewall would either do nothing (the client never
# connects directly) or, worse, block a Cloudflare edge address. Needs the API token to have
# Zone -> Firewall Services -> Edit.
[caddy-auth]
enabled  = @@CADDY_JAIL@@
filter   = caddy-auth
logpath  = @@CADDY_LOG@@
backend  = auto
maxretry = 8
findtime = 5m
bantime  = 2h
action   = cloudflare-token[cftoken="@@CF_API_TOKEN@@", cfzone="@@CF_ZONE@@"]

# Audiobookshelf login guessing on audio.<domain> (J25). ABS has no lockout of its own and its
# POST /login has to bypass Authelia for the mobile apps, so this jail is the lockout: 10 wrong
# passwords in 10 minutes -> the real visitor is banned at Cloudflare for an hour. Looser than
# caddy-auth because an app that holds a stale password retries on its own.
[caddy-abs-login]
enabled  = @@CADDY_JAIL@@
filter   = caddy-abs-login
logpath  = @@CADDY_LOG@@
backend  = auto
maxretry = 10
findtime = 10m
bantime  = 1h
action   = cloudflare-token[cftoken="@@CF_API_TOKEN@@", cfzone="@@CF_ZONE@@"]

# Basic-auth guessing on /opds and /kosync (device paths: no Authelia, no browser check).
# Loose on purpose: reader apps get one 401 challenge per session.
[caddy-device-auth]
enabled  = @@CADDY_JAIL@@
filter   = caddy-device-auth
logpath  = @@CADDY_LOG@@
backend  = auto
maxretry = 30
findtime = 10m
bantime  = 2h
action   = cloudflare-token[cftoken="@@CF_API_TOKEN@@", cfzone="@@CF_ZONE@@"]
