# Rendered by bookstack.sh. Secrets come from environment (see the compose override).
theme: dark
server:
  address: 'tcp://0.0.0.0:9091/'
log:
  level: info
totp:
  issuer: '@@DOMAIN@@'

authentication_backend:
  file:
    path: /config/users_database.yml
    # L05: the host's gate-sync writes portal password changes here; Authelia re-reads the file
    # instead of being restarted (a restart would sign every family member out)
    watch: true
    password:
      algorithm: argon2

access_control:
  default_policy: deny
  rules:
    # Device and app paths cannot do SSO: let them through to the app's own auth (Kobo token,
    # HTTP Basic, ABS token, intake bearer). Same lists as authelia/inject-gate.py BYPASS;
    # first matching rule wins, so these sit before the two_factor rule.
    # Every resource here must be NO LOOSER than the matching Caddy bypass matcher: Caddy only
    # forwards what its matcher does not catch, so a looser rule here is the one that decides.
    # '^/opds.*$' bypassed /opdsfoo as well, which made Caddy's anchored matcher buy nothing.
    # ([/?].*)? — Authelia matches path AND query, so the '?' branch must stay (OPDS search).
    - domain: 'books.@@DOMAIN@@'
      policy: bypass
      resources:
        - '^/kobo/.*$'
        - '^/opds([/?].*)?$'
        - '^/kosync([/?].*)?$'
        # the Kobo reading-services stubs CWA v4.0.7+ answers itself (see the Caddyfile: every
        # other /api path is 403 before the gate)
        - '^/api/v3/content/checkforchanges(\?.*)?$'
        - '^/api/v3/content/[^/?]+/annotations(\?.*)?$'
        - '^/api/UserStorage/[^?]+(\?.*)?$'
        - '^/api/internal/notebooks(/[^?]*)?(\?.*)?$'
    - domain: 'audio.@@DOMAIN@@'
      policy: bypass
      resources:
        - '^/login(\?.*)?$'
        - '^/logout(\?.*)?$'
        # First-run root-user creation. With the gate on and a fresh abs/config there is no
        # Authelia account that can get past it either, so gating /init traps the admin out of
        # the setup screen the self-test tells them to complete.
        - '^/init(\?.*)?$'
        # token refresh (POST); the ABS access token expires after 1 h
        - '^/auth/refresh(\?.*)?$'
        # OIDC login/callback, if the admin ever turns it on in Audiobookshelf (404 until then)
        - '^/auth/openid([/?].*)?$'
        - '^/api/.*$'
        - '^/socket\.io([/?].*)?$'
        - '^/hls/.*$'
        # NO '^/s/.*$' here. It was a guess and there is no route behind it: grepping the
        # pinned ghcr.io/advplyr/audiobookshelf:2.36.1 finds no /s mount in server/Server.js
        # (the mounts are /api, /hls, /public, express.static and the dynamicRoutes list) and
        # no "/s/" URL anywhere in the server or the client bundle. The item-share path is
        # /share/:slug, a CLIENT route served by express.static whose data comes from
        # /public/* (already bypassed above), so /share itself must stay gated. An unanchored
        # bypass of the SSO gate for a prefix nobody can justify against the running image is
        # exactly what this file's own header rule forbids; if a future ABS release mounts
        # something at /s/, add it back WITH the route and version that needs it.
        - '^/ping(\?.*)?$'
        - '^/status(\?.*)?$'
        - '^/healthcheck(\?.*)?$'
        - '^/public/.*$'
        - '^/feed/.*$'
    - domain: 'request.@@DOMAIN@@'
      policy: bypass
      resources:
        - '^/intake(\?.*)?$'
    # everything else on the public apps requires login + 2FA at Authelia first
    - domain:
        - 'books.@@DOMAIN@@'
        - 'audio.@@DOMAIN@@'
        - 'request.@@DOMAIN@@'
        - 'shelf.@@DOMAIN@@'
      policy: two_factor

session:
  name: authelia_session
  cookies:
    - domain: '@@DOMAIN@@'
      authelia_url: 'https://auth.@@DOMAIN@@'
      default_redirection_url: 'https://books.@@DOMAIN@@'
      expiration: '4h'
      inactivity: '30m'

regulation:
  max_retries: 4
  find_time: '2m'
  ban_time: '10m'

storage:
  local:
    path: /config/db.sqlite3

# The block between the markers is replaced by bookstack.sh with an SMTP notifier when SMTP is
# configured (Mail menu). The SMTP password must NOT come from AUTHELIA_NOTIFIER_SMTP_PASSWORD:
# Authelia treats that variable (even empty) as a configured smtp notifier and then refuses to
# start next to the filesystem one ("only one of the 'smtp' or 'filesystem' notifier").
# Instead docker-compose.authelia.yml enables the template filter and passes BOOKSTACK_SMTP_PASS,
# and the rendered smtp block reads it with the template function env "BOOKSTACK_SMTP_PASS"
# piped through quote (double curly braces; not spelled out here because the filter would
# expand it inside this comment too).
# L05: Authelia as the OpenID Connect provider for Audiobookshelf (it has no header login).
# bookstack.sh fills the block between these markers once the gate is on: the signing key is read
# from /config/oidc-jwks.pem and the HMAC secret from the container env by the template filter,
# the client secret is stored hashed. Empty = no OpenID Connect at all.
# @OIDC_BEGIN@
# @OIDC_END@

# @NOTIFIER_BEGIN@
notifier:
  # Writes password-reset messages to a file by default (no mail dependency).
  filesystem:
    filename: /config/notification.txt
# @NOTIFIER_END@
