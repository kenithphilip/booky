	# Rendered per vhost by authelia/inject-gate.py (bypass list per host; no list = no matcher).
	# route{} keeps the Remote-* strip BEFORE forward_auth (Caddy would otherwise order
	# request_header after it), so a bypassed path cannot smuggle a Remote-User header in.
	route {
		request_header -Remote-User
		request_header -Remote-Groups
		request_header -Remote-Email
		request_header -Remote-Name
		request_header -X-Bookstack-Gate
		@authelia_protected not path @@BYPASS@@
		forward_auth @authelia_protected 127.0.0.1:9091 {
			uri /api/authz/forward-auth
			# Authelia logs and regulates on X-Forwarded-For: give it the one real client IP
			# (Cloudflare's CF-Connecting-IP via the global client_ip_headers), not the
			# client-controlled list.
			header_up X-Forwarded-For {client_ip}
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		# L05: vouch for the gated requests only, so the portal can trust Remote-User (one
		# login). A runtime placeholder: the secret never appears in the adapted config.
		request_header @authelia_protected X-Bookstack-Gate {env.BOOKSTACK_GATE_SECRET}
	}
