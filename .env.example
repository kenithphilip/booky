# bookstack.sh writes .env for you (values single-quoted, see envset). This documents every key.
# The file is root:root 0600: compose (root) reads it, the containers' uid 1000 cannot.
# Not listed here: BUILD_VERSION. Deploy/Update pass it to `docker compose build` in the
# environment (git describe of the checkout, else a date stamp); the librarian/caddy images bake
# it in, the portal reports it on /healthz and Self-test compares it with $STACK_DIR/.version.
# Putting it in .env would pin the built images to a stale value.
DOMAIN=mfdata.in
ADMIN_EMAIL=admin@mfdata.in
TZ=Asia/Kolkata
PUID=1000
PGID=1000
PUBLIC_IP=                     # DNS A records (auto-detected only when empty or on request; set by hand behind NAT)
BIND_IP=                       # local address Caddy's public sites listen on (src of `ip route get 1.1.1.1`)
TAILSCALE_IP=
# Your own admin account in Calibre-Web / the portal / Shelfmark (Configure asks; not "admin")
ADMIN_USER=
# Cloudflare API token on this zone: Zone:Read, DNS:Edit, Zone Settings:Edit,
# Cache Rules:Edit (no-cache rule for the public hosts), Firewall Services:Edit (fail2ban bans).
# NOT Config Rules: nothing creates a Configuration Rule (Browser Integrity Check is turned off
# zone-wide instead) and an unused permission on this token is pure risk. See README.
# Stays on the host (bookstack.sh, fail2ban).
CF_API_TOKEN=
# Least-privilege token (Zone -> DNS -> Edit only) that Caddy uses for certificates.
# Configure copies CF_API_TOKEN here when you do not give a separate one.
CF_DNS_TOKEN=
# Request portal
LIBRARIAN_SECRET=
SRC_GUTENBERG=true
SRC_STANDARD=true
SRC_ARCHIVE=true
SRC_LIBRIVOX=true
IA_COLLECTIONS=gutenberg,opensource,americana,cdl
# Your own OPDS catalog (for your own writing) — optional
SRC_MYCATALOG=false
MYCATALOG_NAME=My catalog
MYCATALOG_URL=
MYCATALOG_USER=
MYCATALOG_PASS=
# Audiobookshelf (Library -> Audiobookshelf writes these): API key = scan-on-import + automatic
# per-user tagging + ABS accounts for library users
ABS_TOKEN=
ABS_ROOT_USER=root
ABS_LIBRARY_NAME=Audiobooks
# Authelia (optional SSO gate; written by bookstack.sh)
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_JWT_SECRET=
# Request workflow
APPROVALS_REQUIRED=false      # true = non-admin requests wait for your approval (Library -> Sources)
FAMILY_SHARING=true           # a book already in the library is shared with the next reader, not downloaded again
LIBRARY_RELEASE_DAYS=7        # a book no reader has any more is deleted from the server after this (0 = never)
# bookkeeping: Shelfmark's request step, set by Deploy (sync_shelfmark_requests)
SHELFMARK_REQUESTS=
# Alerts (Install -> Alerts): ntfy-compatible URL, e.g. https://ntfy.sh/<secret-topic>. Host alerts
# (failed backup, full disk) go here directly when the portal is down. Self-test FAILS when this
# and SMTP_HOST are both empty.
NOTIFY_WEBHOOK=
DEDUPE_WARN=true              # flag titles already in the library
# Distributed ingest / acquisition
INTAKE_TOKEN=                 # bearer token for POST /intake; empty = off (404). Library -> Intake turns it on
MAX_UPLOAD_MB=95              # Cloudflare Free/Pro reject request bodies over 100 MB at the edge
GUTENBERG_MIRROR=            # optional local/rsynced Gutenberg mirror base URL
# Email-to-library (optional)
IMAP_HOST=
IMAP_USER=
IMAP_PASS=
IMAP_DEFAULT_USER=
ENRICH_METADATA=true          # Open Library covers/blurbs in the search UI (proxied server-side)
# Shelfmark (CWA companion search/download UI at shelf.<domain>; logs in with CWA users).
# Release sources are enabled by the admin inside Shelfmark's Settings, not here.
SHELFMARK_LANGUAGE=en         # default search language filter
SHELFMARK_TITLE=Library search
SHELFMARK_CONCURRENCY=1       # simultaneous downloads (1 on a 4 GB VPS; each is a process next to Calibre conversions)
SHELFMARK_SEARCH_TIMEOUT=90   # seconds a release search may run. Must stay under Cloudflare's
                              # 100 s origin timeout (error 524) or the reader sees Cloudflare's
                              # error page instead of Shelfmark saying why the search failed.
# Outgoing mail for the portal's Send-to-Kindle (Library -> Mail). Blank host = feature off.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls        # starttls | ssl | none
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                    # users add THIS address to Amazon's approved senders
# Abuse controls (portal). Lockout: N failures per user+IP inside the window -> a lock of
# LOCKOUT_SECONDS; LOCKOUT_IP_FAILS counts any usernames from one address (a family behind one
# NAT shares it, so do not set this too low).
MAX_REQUESTS_PER_DAY=30       # per non-admin user; 0 = unlimited (Library -> Sources)
WANTED_MAX_PER_USER=25        # open "keep looking" entries per reader (a found one becomes a normal request)
WANTED_DAYS=180               # stop looking (and tell the reader) after this many days
KOSYNC_ENABLED=false          # set by Library -> Formats when CWA's KOReader sync is on
LOCKOUT_FAILS=5
LOCKOUT_WINDOW=900            # seconds
LOCKOUT_SECONDS=900           # how long the lock lasts
LOCKOUT_IP_FAILS=20
SESSION_HOURS=12              # portal login lifetime
IMAP_PORT=0                   # 0 = default for the mode (993 implicit TLS / 143 STARTTLS)
IMAP_SSL=true                 # false only for a local/private relay
IMAP_FOLDER=INBOX             # mailbox the intake poller reads
IMAP_ALLOWED_SENDERS=         # comma-separated; blank = the sender must be the user's own e-mail
IMAP_REQUIRE_AUTH=true        # accept mail-in only with DMARC/DKIM/SPF pass in Authentication-Results (Library -> Intake)
# Size ceilings. MAX_UPLOAD_MB is the browser form; the MAX_*_MB below are the worker's
# per-kind download caps (an SSRF/abuse fence as much as a disk one).
MAX_EBOOK_MB=200
MAX_AUDIO_MB=2048             # LibriVox zips of long books run past 1 GB
MAX_PDF_MB=250                # largest PDF the portal accepts for import (it is rendered in memory)
MAX_MAIL_MB=40                # mailed-in attachment cap: a message is PARSED in memory at ~12x
                              # the attachment, so this is deliberately far below MAX_UPLOAD_MB
KINDLE_MAX_MB=45              # Amazon rejects bigger Send-to-Kindle attachments
NOTIFY_WEBHOOK_FORMAT=auto    # auto = ntfy style when the webhook host contains 'ntfy'; or: ntfy | json
# Disk watchdog (scripts/disk-watch.sh, hourly). Percent USED of the disk holding the stack.
DISK_WARN_PCT=85              # alert once per 24 h
DISK_STOP_PCT=95              # stop Shelfmark/qBittorrent and pause the portal's own imports
DISK_RESUME_PCT=80            # start them again below this
# restic retention (scripts/backup.sh nightly `forget --prune`). pre-update snapshots are kept
# 90 days regardless.
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6
# qBittorrent is opt-in (Library -> Torrents): compose profile "torrents", dl. vhost and port 6881
# exist only while this is true. The disk watchdog stops it at 95 % and restarts it below 80 %.
TORRENTS_ENABLED=false
# Library -> Seedbox: the Syncthing container (compose profile "seedbox") receives finished seedbox
# downloads; its API key is generated there. Seedbox addresses and passwords live in
# /etc/bookstack/seedbox.env (0600), never here.
SEEDBOX_ENABLED=false
SYNCTHING_API_KEY=
# Image pins (looked up 2026-09-22). Configure seeds them; Operations -> Update changes them
# (pre-update backup, health gate, rollback). Kuma stays on 1.x.
IMG_CWA=crocodilestick/calibre-web-automated:v4.0.6
IMG_ABS=ghcr.io/advplyr/audiobookshelf:2.36.1
IMG_SHELFMARK=ghcr.io/calibrain/shelfmark:v1.3.15
IMG_QBIT=lscr.io/linuxserver/qbittorrent:5.2.3
IMG_KUMA=louislam/uptime-kuma:1
IMG_AUTHELIA=authelia/authelia:4.39.28
IMG_FLARESOLVERR=ghcr.io/flaresolverr/flaresolverr:v3.5.2
IMG_SYNCTHING=syncthing/syncthing:2.1.5
# Bookkeeping written by bookstack.sh
ADMIN_PW_SET=false            # Deploy set the admin password (Caddy is not started before it is)
ADMIN_USER_PREV=              # set while a rename of the admin account is pending
SSH_LOCKED=false              # Security -> Lock SSH: re-running System keeps port 22 closed
BACKUP_PING_URL=              # optional healthchecks.io-style URL: pinged after each backup (/fail on failure)
# Optional second healthchecks.io-style URL, pinged by scripts/selftest.sh: <url> when every
# check passed, <url>/fail when any did not. BACKUP_PING_URL only fires once a night from the
# backup, so nothing here notices the VPS itself going away between backups. Point this at a
# free dead-man's-switch check with a period a little longer than however often the self-test
# runs unattended (hourly now: period 1 h, grace 1 h), and the box going silent becomes an alert
# instead of a surprise. Operations -> Monitoring asks for it. Blank = nothing is pinged.
HEALTH_PING_URL=
# Uptime Kuma (monitor.<domain>, Tailscale only) is configured by bookstack, not by hand: Deploy
# and Operations -> Monitoring run monitoring/kuma_bootstrap.py. All of these are GENERATED;
# change KUMA_USER/KUMA_PASS only to match an account you changed in Kuma itself.
KUMA_USER=                    # Kuma admin login (default: ADMIN_USER)
KUMA_PASS=                    # generated, 24 characters; shown under Operations -> Monitoring
KUMA_PUSH_SELFTEST=           # push-monitor tokens, one per scheduled job (scripts/kuma-push.sh)
KUMA_PUSH_DISK=
KUMA_PUSH_METAPUSH=
KUMA_PUSH_CFIPS=
KUMA_PUSH_BACKUP=
KUMA_PUSH_CANARY=             # the canary journey's push monitor (only once it is turned on)
KUMA_BOOTSTRAP_AT=            # when the monitors were last reconciled successfully
# FlareSolverr: the shared protection-challenge solver (headless Chromium; compose profile
# "solver"). true = Shelfmark sends challenges to it instead of its built-in Chromium
# (Operations -> FlareSolverr). It also runs whenever Ephemera is on, which always needs it.
FLARESOLVERR_ENABLED=false
FLARESOLVERR_TIMEOUT_MS=60000 # per solve; stays under Shelfmark's 90 s search timeout
AUTHELIA_ENABLED=false
# Ephemera (optional overlay, Operations menu; Tailscale-only; uses the shared FlareSolverr).
# Upstream project is gone — see the docker-compose.ephemera.yml header before enabling.
EPHEMERA_ENABLED=false
EPHEMERA_AA_BASE_URL=         # required by Ephemera: base URL of the archive it searches
EPHEMERA_LG_BASE_URL=         # optional alternative download source
EPHEMERA_AA_API_KEY=          # optional
EPHEMERA_OWNER=               # CWA username whose dropbox receives Ephemera's downloads (default: ADMIN_USER)

# ---- v5 ------------------------------------------------------------------------------------
# Metadata sources (Library -> Metadata sources). Open Library, Gutenberg, LibriVox, Standard
# Ebooks and Internet Archive need no key; these two add coverage when set.
GOOGLE_BOOKS_API_KEY=         # optional; without it Google Books is queried keyless (low daily quota)
HARDCOVER_API_KEY=            # optional; Hardcover's GraphQL API (series, ratings)
SHELFMARK_LANGUAGE=en         # default reading language; each reader can change their own on Devices
WANTED_MAX_PER_USER=25        # "Keep looking" entries per reader
WANTED_DAYS=180               # how long an entry keeps looking before it gives up
CONVERT_MAX_PER_DAY=10        # on-demand format conversions per reader per day (book page -> Convert)
MAX_UPLOAD_TAILNET_MB=2048    # upload.<domain> (Tailscale only) accepts files up to this size
# Shelfmark service account the portal uses for the approval queue (generated by Deploy)
SHELFMARK_SVC_USER=
SHELFMARK_SVC_PASS=
# Security -> Login bot check (Cloudflare Turnstile on the portal login). Both empty = off.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
# Library -> Torrents: the qBittorrent Web UI password (generated; its PBKDF2 hash is written
# into qBittorrent's config before first start, so no temporary password is ever printed)
QBIT_PASS=
# Security -> Authelia: Caddy adds this to requests Authelia let through, so the portal and
# Calibre-Web can trust Remote-User (one login). Generated when the gate is enabled.
GATE_SECRET=
# Security -> Origin lock: which client certificate Caddy accepts from Cloudflare.
# shared = Cloudflare's shared origin-pull CA (any Cloudflare zone); both = switching; zone =
# only the certificate this server issued and uploaded to your zone (AOP_CERT_ID).
AOP_MODE=
AOP_CERT_ID=
AOP_OLD_CERT_ID=
# Operations -> Canary journey: two hidden test accounts walk a reader's path twice a day.
CANARY_USERS=                 # canary-a,canary-b while it is on (hidden from every user list)
CANARY_KINDLE_TO=             # optional: your own Kindle address for a weekly Send-to-Kindle proof
# Security -> Authelia, one login (generated when the gate is enabled):
SHELFMARK_AUTH_METHOD=        # proxy behind the gate (Shelfmark trusts Remote-User), else cwa
ABS_OIDC_SECRET=              # Audiobookshelf's OpenID Connect client secret at Authelia
AUTHELIA_OIDC_HMAC=           # Authelia's OpenID Connect HMAC secret (signing key: authelia/oidc-jwks.pem)
