# bookstack.sh writes .env for you (values single-quoted, see envset). This documents every key.
# The file is root:root 0600: compose (root) reads it, the containers' uid 1000 cannot.
# Not listed here: BUILD_VERSION. Deploy/Update pass it to `docker compose build` in the
# environment (git describe of the checkout, else a date stamp); the librarian/caddy images bake
# it in, the portal reports it on /healthz and Self-test compares it with $STACK_DIR/.version.
# Putting it in .env would pin the built images to a stale value.
DOMAIN=mfdata.in
ADMIN_EMAIL=admin@mfdata.in
TZ=Asia/Kolkata
PUID=1000
PGID=1000
PUBLIC_IP=                     # DNS A records (auto-detected only when empty or on request; set by hand behind NAT)
BIND_IP=                       # local address Caddy's public sites listen on (src of `ip route get 1.1.1.1`)
TAILSCALE_IP=
# Your own admin account in Calibre-Web / the portal / Shelfmark (Configure asks; not "admin")
ADMIN_USER=
# Cloudflare API token on this zone: Zone:Read, DNS:Edit, Zone Settings:Edit, Config Rules:Edit,
# Cache Rules:Edit (no-cache rule for the public hosts), Firewall Services:Edit (fail2ban bans).
# Stays on the host (bookstack.sh, fail2ban).
CF_API_TOKEN=
# Least-privilege token (Zone -> DNS -> Edit only) that Caddy uses for certificates.
# Configure copies CF_API_TOKEN here when you do not give a separate one.
CF_DNS_TOKEN=
# Request portal
LIBRARIAN_SECRET=
SRC_GUTENBERG=true
SRC_STANDARD=false
SRC_ARCHIVE=true
SRC_LIBRIVOX=true
IA_COLLECTIONS=gutenberg,opensource,americana,cdl
# Your own OPDS catalog (for your own writing) — optional
SRC_MYCATALOG=false
MYCATALOG_NAME=My catalog
MYCATALOG_URL=
MYCATALOG_USER=
MYCATALOG_PASS=
# Audiobookshelf (Library -> Audiobookshelf writes these): API key = scan-on-import + automatic
# per-user tagging + ABS accounts for library users
ABS_TOKEN=
ABS_ROOT_USER=root
ABS_LIBRARY_NAME=Audiobooks
# Authelia (optional SSO gate; written by bookstack.sh)
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_JWT_SECRET=
# Request workflow
APPROVALS_REQUIRED=false      # true = non-admin requests wait for your approval (Library -> Sources)
# Alerts (Install -> Alerts): ntfy-compatible URL, e.g. https://ntfy.sh/<secret-topic>. Host alerts
# (failed backup, full disk) go here directly when the portal is down. Self-test FAILS when this
# and SMTP_HOST are both empty.
NOTIFY_WEBHOOK=
DEDUPE_WARN=true              # flag titles already in the library
# Distributed ingest / acquisition
INTAKE_TOKEN=                 # bearer token for POST /intake; empty = off (404). Library -> Intake turns it on
MAX_UPLOAD_MB=95              # Cloudflare Free/Pro reject request bodies over 100 MB at the edge
GUTENBERG_MIRROR=            # optional local/rsynced Gutenberg mirror base URL
# Email-to-library (optional)
IMAP_HOST=
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
IMAP_DEFAULT_USER=
ENRICH_METADATA=true          # Open Library covers/blurbs in the search UI (proxied server-side)
# Shelfmark (CWA companion search/download UI at shelf.<domain>; logs in with CWA users).
# Release sources are enabled by the admin inside Shelfmark's Settings, not here.
SHELFMARK_LANGUAGE=en         # default search language filter
SHELFMARK_TITLE=Library search
SHELFMARK_CONCURRENCY=1       # simultaneous downloads (1 on a 4 GB VPS; each is a process next to Calibre conversions)
# Outgoing mail for the portal's Send-to-Kindle (Library -> Mail). Blank host = feature off.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls        # starttls | ssl | none
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                    # users add THIS address to Amazon's approved senders
# Abuse controls (portal). Lockout: N failures per user+IP inside the window -> a lock of
# LOCKOUT_SECONDS; LOCKOUT_IP_FAILS counts any usernames from one address (a family behind one
# NAT shares it, so do not set this too low).
MAX_REQUESTS_PER_DAY=30       # per non-admin user; 0 = unlimited (Library -> Sources)
KOSYNC_ENABLED=false          # set by Library -> Formats when CWA's KOReader sync is on
LOCKOUT_FAILS=5
LOCKOUT_WINDOW=900            # seconds
LOCKOUT_SECONDS=900           # how long the lock lasts
LOCKOUT_IP_FAILS=20
SESSION_HOURS=12              # portal login lifetime
IMAP_PORT=0                   # 0 = default for the mode (993 implicit TLS / 143 STARTTLS)
IMAP_SSL=true                 # false only for a local/private relay
IMAP_FOLDER=INBOX             # mailbox the intake poller reads
IMAP_ALLOWED_SENDERS=         # comma-separated; blank = the sender must be the user's own e-mail
IMAP_REQUIRE_AUTH=true        # accept mail-in only with DMARC/DKIM/SPF pass in Authentication-Results (Library -> Intake)
# Size ceilings. MAX_UPLOAD_MB is the browser form; the MAX_*_MB below are the worker's
# per-kind download caps (an SSRF/abuse fence as much as a disk one).
MAX_EBOOK_MB=200
MAX_AUDIO_MB=2048             # LibriVox zips of long books run past 1 GB
MAX_PDF_MB=250                # largest PDF the portal accepts for import (it is rendered in memory)
KINDLE_MAX_MB=45              # Amazon rejects bigger Send-to-Kindle attachments
NOTIFY_WEBHOOK_FORMAT=auto    # auto = ntfy style when the webhook host contains 'ntfy'; or: ntfy | json
# Disk watchdog (scripts/disk-watch.sh, hourly). Percent USED of the disk holding the stack.
DISK_WARN_PCT=85              # alert once per 24 h
DISK_STOP_PCT=95              # stop Shelfmark/qBittorrent and pause the portal's own imports
DISK_RESUME_PCT=80            # start them again below this
# restic retention (scripts/backup.sh nightly `forget --prune`). pre-update snapshots are kept
# 90 days regardless.
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6
# qBittorrent is opt-in (Library -> Torrents): compose profile "torrents", dl. vhost and port 6881
# exist only while this is true. The disk watchdog stops it at 95 % and restarts it below 80 %.
TORRENTS_ENABLED=false
# Image pins (looked up 2026-09-22). Configure seeds them; Operations -> Update changes them
# (pre-update backup, health gate, rollback). Kuma stays on 1.x.
IMG_CWA=crocodilestick/calibre-web-automated:v4.0.6
IMG_ABS=ghcr.io/advplyr/audiobookshelf:2.36.1
IMG_SHELFMARK=ghcr.io/calibrain/shelfmark:v1.3.7
IMG_QBIT=lscr.io/linuxserver/qbittorrent:5.2.3
IMG_KUMA=louislam/uptime-kuma:1
IMG_AUTHELIA=authelia/authelia:4.39.28
IMG_FLARESOLVERR=ghcr.io/flaresolverr/flaresolverr:v3.5.2
# Bookkeeping written by bookstack.sh
ADMIN_PW_SET=false            # Deploy set the admin password (Caddy is not started before it is)
ADMIN_USER_PREV=              # set while a rename of the admin account is pending
SSH_LOCKED=false              # Security -> Lock SSH: re-running System keeps port 22 closed
BACKUP_PING_URL=              # optional healthchecks.io-style URL: pinged after each backup (/fail on failure)
AUTHELIA_ENABLED=false
# Ephemera (optional overlay, Operations menu; Tailscale-only). Upstream project is gone — see
# docker-compose.ephemera.yml header before enabling.
EPHEMERA_ENABLED=false
EPHEMERA_AA_BASE_URL=         # required by Ephemera: base URL of the archive it searches
EPHEMERA_LG_BASE_URL=         # optional alternative download source
EPHEMERA_AA_API_KEY=          # optional
EPHEMERA_OWNER=               # CWA username whose dropbox receives Ephemera's downloads (default: ADMIN_USER)
