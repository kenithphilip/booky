# Generated by bookstack.sh from Caddyfile.template. Edit the template, then re-run "Configure".
# Placeholders: @@DOMAIN@@ @@ADMIN_EMAIL@@ @@BIND_IP@@ (local address the public sites listen on;
# differs from the DNS address behind a 1:1 NAT) @@TAILSCALE_IP@@ @@ADMIN_HASH@@.
# Optional blocks the installer deletes when the feature is off (sed '/BEGIN/,/END/d'):
# TORRENTS (dl.), EPHEMERA (ephemera.), AUTHELIA (auth.).
{
	email @@ADMIN_EMAIL@@
	# Admin API on a unix socket inside the container only (never 127.0.0.1:2019 on the host
	# network, where every host-network process could read the running config).
	# bookstack.sh reloads with: caddy reload --config /etc/caddy/Caddyfile --address unix//run/caddy-admin.sock
	admin unix//run/caddy-admin.sock
	order rate_limit before basic_auth
	# The tailnet-only gate (see tailnet_only) must refuse strangers BEFORE basic_auth asks them
	# for the admin password.
	order abort before basic_auth
	servers {
		# Trust only Cloudflare's edge as a proxy, and take the client address from the header
		# Cloudflare itself sets (CF-Connecting-IP, one value, overwritten at the edge). Never
		# from X-Forwarded-For: its left-most entries are whatever the client typed. Requests
		# that do not come from a Cloudflare address keep their socket address.
		trusted_proxies cloudflare {
			interval 12h
			timeout 15s
		}
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

# ---- reusable pieces --------------------------------------------------------

(hardening) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		X-Robots-Tag "noindex, nofollow"
		# Deferred (>) so it replaces whatever the app sent: Cloudflare must never cache a
		# book/audio response from one user's session and serve it to the next.
		# This is the DEFAULT and stays the default. Three sites below add ONE narrow, deferred
		# exception each (books. /static/*, audio. /_nuxt/*, request. /cover) that relaxes
		# `no-store` on paths carrying no per-user content. `private` is never relaxed anywhere:
		# an app that says `public` on an authenticated route would otherwise have that response
		# cached by Cloudflare and handed to the next reader.
		>Cache-Control "private, no-store"
		-Server
		-X-Powered-By
	}
	# Any Remote-* header a client sends is dropped before anything downstream can trust it
	# (the Authelia gate sets them itself, inside its own route{}, after this point).
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Email
	request_header -Remote-Name
	# Client-supplied "my IP is" headers: apps and libraries (ABS's request-ip, Flask ProxyFix)
	# would believe them. The public proxies set X-Forwarded-For / X-Real-IP to {client_ip}.
	# The whole request-ip family is stripped, not just the four an app happens to read today:
	# one app update is enough to turn a header we left alone into a live spoof.
	# Safe for {client_ip}: trusted_proxies/client_ip_headers resolves CF-Connecting-IP in the
	# HTTP server, before any handler runs, so removing the header here only affects upstreams.
	request_header -X-Real-IP
	request_header -X-Client-IP
	# L18: only the Tailscale-only upload. site sets this (header_up below); a client never can
	request_header -X-Bookstack-Upload
	request_header -True-Client-IP
	request_header -Forwarded
	request_header -CF-Connecting-IP
	request_header -Fastly-Client-IP
	request_header -X-Cluster-Client-IP
	request_header -X-Forwarded
	request_header -Forwarded-For
	# Inside a route so it is answered before the (later) Authelia gate route
	route /robots.txt {
		respond <<ROBOTS
			User-agent: *
			Disallow: /
			ROBOTS 200
	}
	encode zstd gzip
	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
		# JSON, minus secrets: the per-user Kobo token in the URI, Audiobookshelf's ?token=
		# query (its apps put the user's JWT on /hls, cover and download URLs), the intake
		# bearer, KOReader's X-Auth-Key, credentials and cookies.
		# fail2ban (configs/fail2ban/*.conf) only needs client_ip, method, uri (path), status;
		# client_ip is the real visitor (CF-Connecting-IP), not the Cloudflare edge.
		format filter {
			wrap json
			fields {
				request>uri regexp "(/kobo/)[0-9a-fA-F]{32}|([?&]token=)[^&]*" "${1}${2}REDACTED"
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>X-Intake-Token delete
				request>headers>X-Auth-Key delete
			}
		}
	}
}

# Public sites: cert via Cloudflare DNS-01, and REQUIRE a Cloudflare client certificate.
# A direct hit on the origin (not through Cloudflare) fails the TLS handshake. Which CA is
# trusted is bookstack.sh's choice (aop_write_trust): Cloudflare's SHARED origin-pull CA, which
# any Cloudflare zone's edge can satisfy, or this zone's own CA (Security -> Origin lock, L14).
# {env.CF_API_TOKEN} is read at runtime, so the token never appears in the adapted config.
# (The compose file fills it from CF_DNS_TOKEN: a token with only Zone:DNS:Edit + Zone:Read.)
(public_tls) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/cf-origin-pull-ca.pem
			}
		}
	}
}

# Private (Tailscale-only) sites: real cert via DNS-01; their DNS names point at the tailnet IP.
(private_tls) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
}

# Private sites deliberately do NOT `bind` the tailnet IP. A bind to an address the host does
# not have (tailscaled logged out, node key expired, re-auth with a new IP) makes Caddy reject
# the WHOLE config and the public sites die with it. Instead they share the default listener
# and anything not arriving from the tailnet is aborted. `remote_ip` is the socket peer (never
# a forwarded header), and the firewall only admits Cloudflare ranges on 80/443 besides
# tailscale0. Connections to the public address still land on the public (BIND_IP) listener,
# which has no private site names. The host's own tailnet address is refused too, so a
# host-network container (portal SSRF) cannot reach the admin tools by dialling it.
(tailnet_only) {
	@not_tailnet not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	abort @not_tailnet
	@tailnet_self remote_ip @@TAILSCALE_IP@@
	abort @tailnet_self
}

# Slow down password guessing on login forms (Cloudflare adds its own layer on top).
# Imported by books., request. and shelf.; audio. has its own, tighter pair of zones
# (see the audio block) because Audiobookshelf has no account lockout.
# A rate_limit zone name is GLOBAL to the Caddy process, so one hardcoded `zone login` gave the
# three sites a single shared 15/min bucket: 8 wrong passwords on shelf. plus 7 on books. was a
# 429 for the whole household. The importer passes its own name, so each site gets its own zone.
#   import login_ratelimit books   ->   zone books_login
(login_ratelimit) {
	rate_limit {
		zone {args[0]}_login {
			match {
				method POST
				path /login* /api/auth/*
			}
			key {client_ip}
			events 15
			window 1m
		}
	}
}

# ---- PUBLIC (through Cloudflare) --------------------------------------------
# Every public reverse_proxy overwrites X-Forwarded-For / X-Real-IP with the one real client IP,
# so the apps' own rate limits and lockouts key on the visitor, not on a spoofable list.

books.@@DOMAIN@@ {
	bind @@BIND_IP@@
	import public_tls
	import hardening
	import login_ratelimit books
	# The deferred Cache-Control in (hardening) REPLACES whatever the app sent (proven: two Caddy
	# 2.11.4 instances, upstream `private, max-age=86400`, client received `private, no-store`).
	# That is right for per-user HTML and for book bytes, and wrong for Calibre-Web's static
	# assets: the pinned v4.0.6 serves /static/* with `Cache-Control: no-cache` AND an ETag, i.e.
	# store-then-revalidate. `no-store` forbids storing, so the browser can never send
	# If-None-Match and the 304 path is dead code - cps/templates/layout.html references 24
	# assets totalling 1,424,404 bytes, re-sent in full on EVERY page view, for every reader,
	# at 1.5-2.2 ms of CWA Python each. On 2 cores that is the tight resource, not bandwidth.
	# So relax `no-store` to `no-cache` HERE ONLY: revalidation stays mandatory (nothing can go
	# stale after a CWA upgrade, the filenames are not content-hashed) and the 304 costs
	# 0.001 s and 0 bytes. `private` is KEPT - never drop the deferred header and let the app's
	# own value through, or an app that says `public` on an authenticated route would have that
	# response cached by Cloudflare for everyone. Written after `import hardening` on purpose:
	# same directive, later instance wins for the matched paths (verified on 2.11.4).
	@cwa_static path /static/* /favicon.ico
	header @cwa_static >Cache-Control "private, no-cache"
	# Device paths use HTTP Basic against CWA (no lockout of its own) and bypass the Authelia
	# gate, so cap them per client: a password oracle at Cloudflare speed is not acceptable.
	#
	# /opds and /kosync CANNOT share a budget, and used to. An OPDS reader fetches one cover
	# per entry, so browsing a shelf is legitimately hundreds of requests a minute and the OPDS
	# ceiling has to stay loose. KOReader syncs a position when a book is opened or closed and
	# every few pages - single digits per minute per device - so it needs nothing like that, and
	# it is the far more dangerous oracle of the two. Measured against the pinned
	# crocodilestick/calibre-web-automated:v4.0.6 with koreader_sync_enabled=1:
	#   GET /kosync/users/auth          no creds -> 401 ; wrong pw -> 401 ; right pw -> 200
	#   GET /kosync/syncs/progress/<id> no creds -> 400 ; wrong pw -> 400 ; right pw -> 200
	# The 400 is not an accident: cps/progress_syncing/protocols/kosync.py:532 raises
	# KOSyncError(ERROR_UNAUTHORIZED_USER) and handle_sync_error() returns it as 400. So the
	# progress endpoints were a clean password oracle answering with a status the 401-based
	# fail2ban filter never counted (configs/fail2ban/caddy-device-auth.conf now counts those
	# 400s too, so the jail can finally fire). CWA's authenticate_user() carries no limiter of
	# its own - flask-limiter is only on web.login_post - and a hit yields that reader's
	# Calibre-Web password, which is also their Shelfmark and Audiobookshelf password. PUT
	# /kosync/syncs/progress behaves identically and is a WRITE. Upstream's own docstring on
	# auth_user() says "Rate limiting should be applied at reverse proxy level ... suggested:
	# 10 requests per minute per IP"; 60 is six times that and far above anything a household
	# of four readers produces, while 300 was 30 guesses a second per source address.
	rate_limit {
		zone device_auth {
			match {
				path /opds*
			}
			key {client_ip}
			events 300
			window 1m
		}
		zone kosync_auth {
			match {
				path /kosync*
			}
			key {client_ip}
			events 60
			window 1m
		}
	}
	# Calibre-Web Automated v4.0.6 registers four blueprints with NO auth decorator at all.
	# Verified inside crocodilestick/calibre-web-automated:v4.0.6 (cps/cwa_functions.py:
	# convert_library, epub_fixer, cwa_logs, cwa_internal; cps/admin.py "/reconnect" is only
	# gated by the CALIBRE_RECONNECT flag). One anonymous GET - or a cross-site <img src> in
	# a logged-in admin's browser - starts a library-wide conversion, runs the EPUB fixer
	# (it rewrites every EPUB and drops the owner tags this stack depends on), reads or
	# downloads the server logs, or reconnects the database.
	# Blocked for EVERYONE here, with or without Authelia (AUTHELIA_ENABLED defaults to
	# false). Nothing a reader, the portal, Shelfmark, OPDS, Kobo or KOReader does touches
	# these paths, and CWA's own callers use http://127.0.0.1:8083 inside the container
	# (cps/helper.py get_internal_api_url), so they never pass through Caddy. The admin
	# reaches the pages the same way from the host if they are ever wanted.
	# Why no remote_ip/client_ip allowlist: books.<domain> resolves to Cloudflare, so
	# remote_ip is always a Cloudflare edge address, and {client_ip} (CF-Connecting-IP) is
	# the visitor's public address - never a tailnet 100.64.0.0/10 one, even for the admin.
	# An allowlist would therefore either match nobody or pin a home IP that changes.
	# /api/v3/* and /api/UserStorage/* are an UNAUTHENTICATED OPEN RELAY to Kobo and are
	# blocked here for the same reason. Verified in the pinned image
	# (cps/readingservices.py:35-36 registers both blueprints; :117-142
	# requires_reading_services_auth_and_config PROXIES to
	# https://readingservices.kobo.com whenever annotation sync is off, Kobo sync is off, or
	# the caller is anonymous - all three are the default here - and :596/:609 are
	# <path:subpath> catch-alls). proxy_to_kobo_reading_services forwards the caller's
	# method, headers and body and returns the response verbatim, so books.<domain> would
	# lend its IP and its Cloudflare reputation to anyone who asks.
	# Nothing else in CWA v4.0.6 mounts under /api (only /gdrive, /kobo/<auth_token>,
	# /kobo_auth and /login have url_prefixes; the web UI's own calls go to /ajax/*), so the
	# 403 cannot break the pages, OPDS, KOReader or /kobo/<token>/ sync.
	# On CWA v4.0.6 no real Kobo sent these here: cps/kobo.py:1370/1389 only advertised
	# "reading_services_host" as THIS server when config_hardcover_annotations_sync is on and
	# the hardcover module loaded; otherwise the device keeps the built-in
	# https://readingservices.kobo.com (kobo.py:1543) and never touches our origin. So the 403
	# costs a device nothing, and every request it does answer was somebody else's.
	# v4.0.7 changed that (see the comment on the route below): four stub paths now pass.
	# IF Hardcover annotation sync is ever enabled (config_hardcover_annotations_sync +
	# config_kobo_sync), these two prefixes must MOVE OUT of the block below and INTO:
	#   * the Authelia bypass list for books (authelia/inject-gate.py BYPASS["books"] and the
	#     matching resources in authelia/configuration.yml.template), and
	#   * the Cloudflare Browser-Integrity-Check exception,
	# because they are the one Kobo path NOT under /kobo/<token>/ - the device sends them
	# with its own Authorization header and no session cookie.
	# /duplicates/invalidate-cache is a THIRD route of the same class and is blocked here too.
	# Verified in the pinned image: cps/duplicates.py:1196 declares
	# @duplicates.route("/duplicates/invalidate-cache", methods=['POST']) with @csrf.exempt and
	# NO auth decorator, while every sibling in the same file (/duplicates, /duplicates/status,
	# /duplicates/dismiss/*, /duplicates/undismiss/*, /duplicates/trigger-scan) carries
	# @login_required_if_no_ano + @admin_or_edit_required. The blueprint is registered
	# unconditionally and CWA has no global auth before_request, so anonymous POSTs commit
	# `UPDATE cwa_duplicate_cache SET scan_pending=1` into cwa.db - unbounded writes on a 2-core
	# box, and a permanent scan_pending that makes every visit to the duplicates page re-run a
	# full-library duplicate scan. Only the ONE path, not the /duplicates* prefix: the other
	# routes are the admin's own UI and are already gated. Same argument as the four above -
	# the sole in-tree caller is CWA's own scripts/ingest_processor.py via
	# get_internal_api_url() -> http://127.0.0.1:8083 INSIDE the container, which never passes
	# through Caddy - so nothing a reader, the portal, Shelfmark, OPDS, Kobo or KOReader does
	# can break.
	# route{} so the 403 is decided ahead of the Authelia gate route below.
	# CWA v4.0.7 CHANGED the Kobo reading services (cps/kobo.py HandleInitRequest and
	# _kobo_reading_services_stub, read 2026-09-28): with the Kobo store proxy off (ours) it tells
	# the device reading_services_host = THIS site, and the device then calls four paths at the
	# site root: /api/v3/content/checkforchanges, /api/v3/content/<id>/annotations,
	# /api/UserStorage/*, /api/internal/notebooks. A @kobo.before_app_request hook answers exactly
	# those with constant empty JSON before any view runs, and if they fail the device ABORTS the
	# whole sync ("Sync Failed", measured on a real Kobo the day it was deployed). So on v4.0.7+
	# those four shapes pass (Authelia bypasses them too, authelia/inject-gate.py) and every
	# OTHER /api/v3, /api/UserStorage and /api/internal path — still the open relay below — stays
	# 403. @@KOBO_RS_BLOCK@@ is filled by bookstack.sh render_caddyfile: empty for CWA >= v4.0.7,
	# the four relay prefixes for anything older (whose stub-shaped paths ARE the relay).
	route {
		@cwa_admin_jobs path /cwa-convert-library-overview /cwa-convert-library-start /cwa-convert-library /cwa-convert-library/* /convert-library-status /convert-library-cancel /cwa-epub-fixer-overview /cwa-epub-fixer-start /cwa-epub-fixer /cwa-epub-fixer/* /epub-fixer-status /epub-fixer-cancel /cwa-logs /cwa-logs/* /cwa-internal /cwa-internal/* /reconnect /duplicates/invalidate-cache@@KOBO_RS_BLOCK@@
		respond @cwa_admin_jobs "Not available" 403
		# `path` is case-insensitive, path_regexp is not, and CWA's stub compares exact strings:
		# /api/userstorage/x is caught here and never reaches the relay either.
		@kobo_relay {
			path /api/v3 /api/v3/* /api/UserStorage /api/UserStorage/* /api/internal /api/internal/*
			not path_regexp kobo_rs_stub ^/api/(?:v3/content/checkforchanges|v3/content/[^/]+/annotations|UserStorage/[A-Za-z0-9._/-]+|internal/notebooks(?:/[A-Za-z0-9._/-]*)?)$
		}
		respond @kobo_relay "Not available" 403
		# The one shape the exact list above cannot express: an old-style ';' path parameter.
		# /cwa-convert-library-start;x is a different string to `path` but the same endpoint to
		# some routers. Werkzeug 404s it today, so this is defence in depth, not a live hole.
		# `path` is case-insensitive; path_regexp is not, hence (?i).
		@cwa_admin_jobs_params path_regexp cwa_admin_jobs_params (?i)^/(?:cwa-convert-library|convert-library-status|convert-library-cancel|cwa-epub-fixer|epub-fixer-status|epub-fixer-cancel|cwa-logs|cwa-internal|reconnect|api/v3|api/UserStorage|duplicates/invalidate-cache).*;
		respond @cwa_admin_jobs_params "Not available" 403
	}
	# @AUTHELIA_GATE:books@
	reverse_proxy 127.0.0.1:8083 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}

audio.@@DOMAIN@@ {
	bind @@BIND_IP@@
	import public_tls
	import hardening
	# Same reasoning as books./static: Audiobookshelf's web bundle is served by express.static,
	# which sends ETag + Last-Modified, and `no-store` from (hardening) kills the 304. Relaxed
	# to `no-cache` (revalidate every time) rather than a max-age, so nothing can be stale after
	# an ABS upgrade. `private` kept, as everywhere.
	@abs_static path /_nuxt/* /favicon.ico
	header @abs_static >Cache-Control "private, no-cache"
	# Audiobookshelf 2.36.1 has no account lockout; its only defence is an express
	# rate-limiter of 40 requests / 10 min per client IP (server/utils/rateLimiterFactory.js)
	# SHARED by POST /login, POST /auth/refresh and PATCH /api/me/password. Password guessing
	# therefore gets its own, much tighter zone here, and the token refresh keeps a separate
	# budget so a family's devices can never spend the login allowance.
	# The apps refresh their 1 h access token about once an hour per device, and everything
	# else they do is GET/POST under /api, /socket.io, /hls and /s, which neither zone
	# matches - so normal use never approaches these limits.
	rate_limit {
		zone audio_login {
			match {
				method POST
				# ABS serves the password form at POST /login; /api/login is not a route in
				# 2.36.1 but is matched anyway so a future rename cannot silently unthrottle.
				path /login /api/login /api/auth/login
			}
			key {client_ip}
			events 5
			window 1m
		}
		zone audio_token {
			match {
				method POST
				# POST /auth/refresh (and the OIDC callbacks under /auth/openid)
				path /auth/*
			}
			key {client_ip}
			events 15
			window 1m
		}
	}
	# @AUTHELIA_GATE:audio@
	reverse_proxy 127.0.0.1:13378 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}

# ---- PUBLIC: per-user request/fetch portal (through Cloudflare) --------------

request.@@DOMAIN@@ {
	bind @@BIND_IP@@
	import public_tls
	import hardening
	import login_ratelimit request
	# /cover proxies covers.openlibrary.org so the reader's browser never talks to a third party
	# (librarian/enrich.py's docstring). The portal already answers it with
	# `private, max-age=604800` and (hardening) was overwriting that with `no-store`, so every
	# search page re-fetched all eight covers through the portal's gunicorn threads. Restated
	# here, deferred, so the edge and the app agree; `private` is explicit rather than inherited,
	# because /cover is a @login_required route and Cloudflare must never share one reader's
	# response with another.
	@portal_cover path /cover
	header @portal_cover >Cache-Control "private, max-age=604800"
	# Bulk-download and automation abuse limits (per real client IP)
	rate_limit {
		zone portal_downloads {
			match {
				path /download/*
			}
			key {client_ip}
			events 120
			window 1m
		}
		zone portal_intake {
			match {
				path /intake
			}
			key {client_ip}
			events 60
			window 1m
		}
	}
	# @AUTHELIA_GATE:request@
	reverse_proxy 127.0.0.1:8090 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}

# ---- PUBLIC: Shelfmark search/download UI (through Cloudflare) --------------
# Logs in with Calibre-Web accounts; downloads land in the user's dropbox.

shelf.@@DOMAIN@@ {
	bind @@BIND_IP@@
	import public_tls
	import hardening
	import login_ratelimit shelf
	# @AUTHELIA_GATE:shelf@
	reverse_proxy 127.0.0.1:8084 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}

# ---- PUBLIC: Authelia SSO portal (only used when the gate is enabled) --------

# @AUTHELIA_BEGIN@
auth.@@DOMAIN@@ {
	bind @@BIND_IP@@
	import public_tls
	import hardening
	rate_limit {
		zone authelia_login {
			match {
				method POST
				path /api/firstfactor /api/secondfactor/* /api/reset-password/*
			}
			key {client_ip}
			events 15
			window 1m
		}
	}
	# Authelia's own regulation (failed-login bans) keys on X-Forwarded-For.
	reverse_proxy 127.0.0.1:9091 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}
# @AUTHELIA_END@

# ---- PRIVATE: uptime monitoring (Tailscale only) ----------------------------

monitor.@@DOMAIN@@ {
	import tailnet_only
	import private_tls
	import hardening
	reverse_proxy 127.0.0.1:3001
}

# ---- PRIVATE: large uploads (Tailscale only) -------------------------------------
# Cloudflare caps a browser upload at 100 MB, so an audiobook zip cannot go through request.
# This site is the portal again, reached over Tailscale (grey-cloud DNS to the tailnet IP), with
# a 2 GB body limit; the portal raises its own limit only when this marker is present.
upload.@@DOMAIN@@ {
	import tailnet_only
	import private_tls
	import hardening
	request_body {
		max_size 2GB
	}
	reverse_proxy 127.0.0.1:8090 {
		header_up X-Bookstack-Upload tailnet
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}

# ---- PRIVATE: qBittorrent (Tailscale only, optional, Library -> Torrents) ----
# @TORRENTS_BEGIN@
dl.@@DOMAIN@@ {
	import tailnet_only
	import private_tls
	import hardening
	basic_auth {
		admin @@ADMIN_HASH@@
	}
	# qBittorrent validates the Host header (on by default) and answers "Unauthorized" for
	# dl.<domain>; present the upstream's own host:port instead.
	reverse_proxy 127.0.0.1:8080 {
		header_up Host {upstream_hostport}
	}
}
# @TORRENTS_END@

# ---- PRIVATE: Ephemera (Tailscale only, optional overlay) --------------------
# Ephemera has no login of its own, so it sits behind the admin password gate.
# @EPHEMERA_BEGIN@
ephemera.@@DOMAIN@@ {
	import tailnet_only
	import private_tls
	import hardening
	basic_auth {
		admin @@ADMIN_HASH@@
	}
	reverse_proxy 127.0.0.1:8286
}
# @EPHEMERA_END@
